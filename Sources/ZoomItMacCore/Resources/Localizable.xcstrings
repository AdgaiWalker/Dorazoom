    "settings.draw.shapes.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While dragging, hold Shift for a line, Control for a rectangle, Tab for an ellipse, or Shift+Control for an arrow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时，按住 Shift 绘制直线，按住 Control 绘制矩形，按住 Tab 绘制椭圆，同时按住 Shift+Control 绘制箭头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移時，按住 Shift 繪製直線，按住 Control 繪製矩形，按住 Tab 繪製橢圓形，同時按住 Shift+Control 繪製箭頭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中に Shift を押すと直線、Control で長方形、Tab で楕円、Shift+Control で矢印を描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 Shift를 누르면 선, Control을 누르면 직사각형, Tab을 누르면 타원, Shift+Control을 누르면 화살표를 그립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte beim Ziehen Shift für eine Linie, Control für ein Rechteck, Tab für eine Ellipse oder Shift+Control für einen Pfeil gedrückt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le glissement, maintenez Shift pour une ligne, Control pour un rectangle, Tab pour une ellipse ou Shift+Control pour une flèche."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras arrastras, mantén Shift para una línea, Control para un rectángulo, Tab para una elipse o Shift+Control para una flecha."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras arrastras, mantén Shift para una línea, Control para un rectángulo, Tab para una elipse o Shift+Control para una flecha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto arrasta, segure Shift para uma linha, Control para um retângulo, Tab para uma elipse ou Shift+Control para uma seta."
          }
        }
      }
    },
