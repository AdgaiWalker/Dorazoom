    "settings.general.login_item_error.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom saved your startup preference and will try again next launch. macOS reported: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom 已保存你的启动偏好，并会在下次启动时重试。macOS 报告：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom 已儲存你的啟動偏好設定，並會在下次啟動時重試。macOS 回報：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom は「ログイン時に開く」設定を保存しました。次回の起動時にもう一度試します。macOS からの応答：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom이 로그인 시 실행 설정을 저장했으며 다음번 실행 때 다시 시도합니다. macOS 응답: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom hat deine Starteinstellung gesichert und versucht es beim nächsten Start erneut. macOS meldete: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom a enregistré votre préférence de démarrage et réessaiera au prochain lancement. macOS a indiqué : %@"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
