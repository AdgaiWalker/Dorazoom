    "drawing_shortcut_guide.canvas": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While drawing, press W for a whiteboard or K for a blackboard. Choose another canvas state to return. W and K are not global shortcuts and do not require Control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘图时，按 W 切换到白板，按 K 切换到黑板。选择其他画布状态即可返回。W 和 K 不是全局快捷键，也不需要按 Control。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪圖時，按 W 切換至白板，按 K 切換至黑板。選擇其他畫布狀態即可返回。W 和 K 不是全域快速鍵，也不需要按 Control。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画中に W を押すとホワイトボード、K を押すとブラックボードになります。別のキャンバス状態を選ぶと元に戻ります。W と K はグローバルショートカットではなく、Control は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리는 동안 W를 누르면 화이트보드, K를 누르면 블랙보드로 바뀝니다. 다른 캔버스 상태를 선택하면 돌아갑니다. W와 K는 전역 단축키가 아니며 Control을 누를 필요가 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke beim Zeichnen W für eine weiße Tafel oder K für eine schwarze Tafel. Wähle einen anderen Leinwandzustand, um zurückzukehren. W und K sind keine globalen Kurzbefehle und benötigen kein Control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le dessin, appuyez sur W pour un tableau blanc ou sur K pour un tableau noir. Choisissez un autre état de canevas pour revenir. W et K ne sont pas des raccourcis globaux et ne nécessitent pas Control."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras dibujas, pulsa W para usar una pizarra blanca o K para una pizarra negra. Elige otro estado de lienzo para volver. W y K no son atajos globales y no requieren Control."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras dibujas, presiona W para usar un pizarrón blanco o K para uno negro. Elige otro estado del lienzo para regresar. W y K no son atajos globales y no requieren Control."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto desenha, pressione W para usar um quadro branco ou K para um quadro negro. Escolha outro estado da tela para voltar. W e K não são atalhos globais e não exigem Control."
          }
        }
      }
    },
    "drawing_shortcut_guide.colors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press R / G / B / Y / O / P to switch the pen to red, green, blue, yellow, orange, or pink. White and black have no default shortcuts; choose them from the color controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 R / G / B / Y / O / P 可将画笔切换为红、绿、蓝、黄、橙或粉色。白色和黑色没有默认快捷键，请从颜色控件中选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 R / G / B / Y / O / P 可將畫筆切換為紅、綠、藍、黃、橘或粉紅色。白色和黑色沒有預設快速鍵，請從顏色控制項目中選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "R / G / B / Y / O / P を押すと、ペンを赤、緑、青、黄、オレンジ、ピンクに切り替えます。白と黒にはデフォルトのショートカットがないため、カラーコントロールから選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "R / G / B / Y / O / P를 눌러 펜을 빨간색, 초록색, 파란색, 노란색, 주황색, 분홍색으로 바꿉니다. 흰색과 검은색에는 기본 단축키가 없으므로 색상 컨트롤에서 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke R / G / B / Y / O / P, um den Stift auf Rot, Grün, Blau, Gelb, Orange oder Pink umzustellen. Weiß und Schwarz haben keine Standardtasten; wähle sie in der Farbsteuerung aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur R / G / B / Y / O / P pour choisir un crayon rouge, vert, bleu, jaune, orange ou rose. Le blanc et le noir n’ont pas de touches par défaut ; choisissez-les dans les commandes de couleur."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa R / G / B / Y / O / P para cambiar el lápiz a rojo, verde, azul, amarillo, naranja o rosa. El blanco y el negro no tienen teclas predeterminadas; elígelos en los controles de color."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona R / G / B / Y / O / P para cambiar la pluma a rojo, verde, azul, amarillo, naranja o rosa. El blanco y el negro no tienen teclas predeterminadas; selecciónalos en los controles de color."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione R / G / B / Y / O / P para mudar a caneta para vermelho, verde, azul, amarelo, laranja ou rosa. Branco e preto não têm teclas padrão; escolha-os nos controles de cor."
          }
        }
      }
    },
    "drawing_shortcut_guide.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While drawing, press T to start left-aligned text or Shift+T for right-aligned text. Clicking a new position commits the current text and starts another. Press Esc to finish editing. Use the scroll wheel or Command++ / Command+- to change the font size. Arrow keys, Delete, selection, and paste are handled by the macOS text system."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘图时，按 T 开始输入左对齐文本，按 Shift+T 输入右对齐文本。点击新位置会提交当前文本并开始输入下一段。按 Esc 结束编辑。使用滚轮或 Command++ / Command+- 更改字号。方向键、Delete、选择和粘贴由 macOS 文本系统处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪圖時，按 T 開始輸入靠左對齊文字，按 Shift+T 輸入靠右對齊文字。按一下新位置會送出目前文字並開始輸入下一段。按 Esc 結束編輯。使用滾輪或 Command++ / Command+- 更改字級。方向鍵、Delete、選取和貼上由 macOS 文字系統處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画中に T を押すと左揃え、Shift+T を押すと右揃えのテキスト入力を開始します。別の位置をクリックすると現在のテキストが確定し、次の入力が始まります。Esc を押すと編集を終了します。スクロールホイールまたは Command++ / Command+- でフォントサイズを変更できます。矢印キー、Delete、選択、ペーストは macOS のテキストシステムで処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리는 동안 T를 누르면 왼쪽 정렬 텍스트, Shift+T를 누르면 오른쪽 정렬 텍스트 입력을 시작합니다. 새 위치를 클릭하면 현재 텍스트를 확정하고 다음 입력을 시작합니다. Esc를 누르면 편집이 끝납니다. 스크롤 휠이나 Command++ / Command+-로 글꼴 크기를 바꿀 수 있습니다. 방향키, Delete, 선택, 붙여넣기는 macOS 텍스트 시스템에서 처리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke beim Zeichnen T für linksbündigen Text oder Shift+T für rechtsbündigen Text. Ein Klick auf eine neue Position übernimmt den aktuellen Text und beginnt einen neuen. Drücke zum Beenden der Bearbeitung Escape. Ändere die Schriftgröße mit dem Scrollrad oder Command++ / Command+-. Pfeiltasten, Löschen, Auswahl und Einfügen werden vom macOS-Textsystem verarbeitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le dessin, appuyez sur T pour saisir du texte aligné à gauche ou sur Shift+T pour l’aligner à droite. Cliquer à un nouvel endroit valide le texte actuel et en commence un autre. Appuyez sur Échap pour terminer. Utilisez la molette ou Command++ / Command+- pour modifier la taille de police. Les touches fléchées, la suppression, la sélection et le collage sont gérés par le système de texte de macOS."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras dibujas, pulsa T para iniciar texto alineado a la izquierda o Shift+T para alinearlo a la derecha. Hacer clic en otra posición confirma el texto actual e inicia uno nuevo. Pulsa Escape para terminar la edición. Usa la rueda o Command++ / Command+- para cambiar el tamaño de letra. Las flechas, Suprimir, la selección y el pegado los gestiona el sistema de texto de macOS."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras dibujas, presiona T para iniciar texto alineado a la izquierda o Shift+T para alinearlo a la derecha. Al hacer clic en otra posición se confirma el texto actual y se inicia uno nuevo. Presiona Escape para terminar la edición. Usa la rueda o Command++ / Command+- para cambiar el tamaño de letra. Las flechas, Eliminar, la selección y el pegado los administra el sistema de texto de macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto desenha, pressione T para iniciar um texto alinhado à esquerda ou Shift+T para alinhá-lo à direita. Clicar em outro local confirma o texto atual e inicia um novo. Pressione Escape para terminar a edição. Use a roda ou Command++ / Command+- para alterar o tamanho da fonte. As setas, Apagar, seleção e colagem são controladas pelo sistema de texto do macOS."
          }
        }
      }
    },
