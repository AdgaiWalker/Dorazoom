    "settings.live_zoom.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Zoom magnifies the live screen, so motion and updates remain visible. Use the same zoom and pan controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时缩放会放大当前屏幕，同时保留画面动态和实时更新。缩放和平移方式保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時縮放會放大目前螢幕，同時保留畫面動態和即時更新。縮放和平移方式保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブズームは動いている画面を拡大するため、動きや更新もそのまま表示されます。同じズームとパンの操作を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 확대는 현재 화면을 확대하므로 움직임과 업데이트가 계속 보입니다. 동일한 확대 및 이동 조작을 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Zoom vergrößert den aktuellen Bildschirm, sodass Bewegungen und Aktualisierungen sichtbar bleiben. Verwende dieselben Steuerelemente für Zoom und Verschieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le zoom en direct agrandit l’écran en temps réel afin que les mouvements et mises à jour restent visibles. Utilisez les mêmes commandes de zoom et de déplacement."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El zoom en directo amplía la pantalla en tiempo real para mantener visibles el movimiento y los cambios. Usa los mismos controles de zoom y desplazamiento."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El zoom en vivo amplía la pantalla en tiempo real para mantener visibles el movimiento y los cambios. Usa los mismos controles de zoom y desplazamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O zoom ao vivo amplia a tela em tempo real para manter movimentos e mudanças visíveis. Use os mesmos controles de zoom e deslocamento."
          }
        }
      }
    },
