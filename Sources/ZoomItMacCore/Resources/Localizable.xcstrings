    "settings.draw.pen.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change pen width with the mouse wheel, the [ and ] keys, or Shift with the Up and Down Arrow keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鼠标滚轮、[ 和 ] 键，或按住 Shift 并按上、下方向键来更改画笔宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用滑鼠滾輪、[ 和 ] 鍵，或按住 Shift 並按上、下方向鍵來更改畫筆寬度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスホイール、[ キーと ] キー、または Shift+上矢印／Shift+下矢印でペンの太さを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 휠, [ 키와 ] 키 또는 Shift+위쪽 화살표/Shift+아래쪽 화살표로 펜 두께를 바꿉니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Stiftbreite mit dem Mausrad, den Tasten [ und ] oder Shift zusammen mit den Pfeiltasten nach oben und unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez l’épaisseur du crayon avec la molette, les touches [ et ], ou Shift avec les touches fléchées vers le haut et le bas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el grosor del lápiz con la rueda, las teclas [ y ], o Shift con las flechas arriba y abajo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el grosor de la pluma con la rueda, las teclas [ y ], o Shift con las flechas arriba y abajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere a espessura da caneta com a roda, as teclas [ e ], ou Shift com as setas para cima e para baixo."
          }
        }
      }
    },
