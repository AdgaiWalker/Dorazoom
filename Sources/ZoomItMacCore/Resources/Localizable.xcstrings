    "permission_center.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom requests access only when you use the related feature. This page refreshes automatically when you return to DoraZoom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom 仅在你使用相关功能时请求访问权限。返回 DoraZoom 后，此页面会自动刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom 只會在你使用相關功能時要求存取權限。返回 DoraZoom 後，此頁面會自動重新整理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom は、関連する機能を使うときだけアクセスを要求します。DoraZoom に戻ると、このページは自動的に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom은 관련 기능을 사용할 때만 접근 권한을 요청합니다. DoraZoom으로 돌아오면 이 페이지가 자동으로 새로 고쳐집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom fordert den Zugriff erst an, wenn du die zugehörige Funktion verwendest. Diese Seite wird automatisch aktualisiert, wenn du zu DoraZoom zurückkehrst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom demande l’accès uniquement lorsque vous utilisez la fonction correspondante. Cette page s’actualise automatiquement à votre retour dans DoraZoom."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom solo solicita acceso cuando usas la función correspondiente. Esta página se actualiza automáticamente al volver a DoraZoom."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom solo solicita acceso cuando usas la función correspondiente. Esta página se actualiza automáticamente cuando regresas a DoraZoom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DoraZoom só solicita acesso quando você usa o recurso correspondente. Esta página é atualizada automaticamente quando você volta ao DoraZoom."
          }
        }
      }
    },
