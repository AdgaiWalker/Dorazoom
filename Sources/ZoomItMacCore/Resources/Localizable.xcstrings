    "settings.zoom.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After activating DoraZoom, zoom with the mouse wheel or Option+Up and Option+Down, then pan by moving the mouse. Exit zoom mode with Escape or the right mouse button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活 DoraZoom 后，使用鼠标滚轮或 Option+上、Option+下进行缩放，再通过移动鼠标平移。按 Escape 或鼠标右键退出缩放模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 DoraZoom 後，使用滑鼠滾輪或 Option+上、Option+下進行縮放，再透過移動滑鼠平移。按 Escape 或滑鼠右鍵離開縮放模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom を有効にした後、マウスホイールまたは Option+上矢印／Option+下矢印でズームし、マウスを動かしてパンします。Escape またはマウスの右ボタンでズームモードを終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom을 활성화한 후 마우스 휠이나 Option+위쪽 화살표 및 Option+아래쪽 화살표로 확대하고, 마우스를 움직여 화면을 이동합니다. Escape 또는 마우스 오른쪽 버튼으로 확대 모드를 종료합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoome nach dem Aktivieren von DoraZoom mit dem Mausrad oder Option+Auf und Option+Ab und verschiebe dann den Ausschnitt mit der Maus. Beende den Zoommodus mit Escape oder der rechten Maustaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir activé DoraZoom, zoomez avec la molette ou Option+Haut et Option+Bas, puis déplacez la vue avec la souris. Quittez le mode zoom avec Échap ou le bouton droit de la souris."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de activar DoraZoom, amplía con la rueda o con Option+Arriba y Option+Abajo, y desplaza la vista moviendo el ratón. Sal del modo zoom con Escape o el botón derecho."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de activar DoraZoom, amplía con la rueda o con Option+Arriba y Option+Abajo, y desplaza la vista moviendo el mouse. Sal del modo zoom con Escape o el botón derecho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de ativar o DoraZoom, amplie com a roda ou com Option+Para Cima e Option+Para Baixo, e desloque a visualização movendo o mouse. Saia do modo de zoom com Escape ou o botão direito."
          }
        }
      }
    },
