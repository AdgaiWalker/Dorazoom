    "settings.shortcuts.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a shortcut, then enter a new key combination. Global shortcuts pause only while recording; press Escape to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击快捷键，然后输入新的按键组合。全局快捷键仅在录制时暂停；按 Escape 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下快速鍵，然後輸入新的按鍵組合。全域快速鍵只會在錄製時暫停；按 Escape 取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットをクリックしてから、新しいキーの組み合わせを入力します。グローバルショートカットは収録中だけ一時停止します。Escape を押すとキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 클릭한 다음 새 키 조합을 입력합니다. 전역 단축키는 녹화 중에만 일시 중지됩니다. Escape를 누르면 취소합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Kurzbefehl und gib dann eine neue Tastenkombination ein. Globale Kurzbefehle sind nur während der Aufzeichnung einer neuen Tastenkombination pausiert; drücke zum Abbrechen Escape."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un raccourci, puis saisissez une nouvelle combinaison. Les raccourcis globaux sont suspendus uniquement pendant la saisie ; appuyez sur Échap pour annuler."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un atajo e introduce una combinación nueva. Los atajos globales solo se pausan mientras introduces la nueva combinación; pulsa Escape para cancelar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un atajo e ingresa una combinación nueva. Los atajos globales solo se pausan mientras ingresas la nueva combinación; presiona Escape para cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um atalho e insira uma nova combinação. Os atalhos globais só ficam pausados enquanto você define a nova combinação; pressione Escape para cancelar."
          }
        }
      }
    },
