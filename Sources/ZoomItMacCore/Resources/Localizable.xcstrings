    "settings.advanced_capture.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Window Under Pointer copies the frontmost standard window beneath the pointer without creating a local file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“捕捉指针下的窗口”会复制指针下方最前面的标准窗口，不会创建本地文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「擷取指標下方的視窗」會複製指標下方最前面的標準視窗，不會建立本機檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ポインタ下のウインドウを取り込む」は、ローカルファイルを作成せず、ポインタの下にある最前面の標準ウインドウをコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘포인터 아래 윈도우 캡처’는 로컬 파일을 만들지 않고 포인터 아래에 있는 가장 앞쪽의 표준 윈도우를 복사합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Fenster unter dem Zeiger aufnehmen“ kopiert das vorderste Standardfenster unter dem Zeiger, ohne eine lokale Datei zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Capturer la fenêtre sous le pointeur » copie la fenêtre standard au premier plan sous le pointeur sans créer de fichier local."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "«Capturar ventana bajo el puntero» copia la ventana estándar en primer plano bajo el puntero sin crear un archivo local."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "“Capturar ventana bajo el puntero” copia la ventana estándar en primer plano bajo el puntero sin crear un archivo local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Capturar janela sob o ponteiro” copia a janela padrão em primeiro plano sob o ponteiro sem criar um arquivo local."
          }
        }
      }
    },
