    "settings.draw.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While zoomed, press the left mouse button to start drawing and the right mouse button to stop. Undo with Command-Z or Control-Z, and press E to erase all drawing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放时，按鼠标左键开始绘图，按鼠标右键停止。使用 Command-Z 或 Control-Z 撤销，按 E 清除所有绘图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮放時，按滑鼠左鍵開始繪圖，按滑鼠右鍵停止。使用 Command-Z 或 Control-Z 還原，按 E 清除所有繪圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズーム中にマウスの左ボタンを押すと描画を開始し、右ボタンを押すと停止します。Command-Z または Control-Z で取り消し、E を押すとすべての描画を消去します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대 중에 마우스 왼쪽 버튼을 누르면 그리기를 시작하고 오른쪽 버튼을 누르면 중지합니다. Command-Z 또는 Control-Z로 실행 취소하고, E를 누르면 모든 그리기를 지웁니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke während des Zooms die linke Maustaste, um mit dem Zeichnen zu beginnen, und die rechte Maustaste, um es zu beenden. Widerrufe mit Command-Z oder Control-Z und lösche alle Zeichnungen mit E."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le zoom, appuyez sur le bouton gauche de la souris pour commencer à dessiner et sur le bouton droit pour arrêter. Annulez avec Command-Z ou Control-Z et appuyez sur E pour effacer tous les dessins."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el zoom activo, pulsa el botón izquierdo del ratón para empezar a dibujar y el derecho para parar. Deshaz con Command-Z o Control-Z y pulsa E para borrar todos los dibujos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el zoom activo, presiona el botón izquierdo del mouse para empezar a dibujar y el derecho para detenerte. Deshaz con Command-Z o Control-Z y presiona E para borrar todos los dibujos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o zoom ativo, pressione o botão esquerdo do mouse para começar a desenhar e o direito para parar. Desfaça com Command-Z ou Control-Z e pressione E para apagar todos os desenhos."
          }
        }
      }
    },
    "settings.draw.highlight.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Shift with a color key, such as Shift+R, to draw with a translucent highlighter. Press the color key again without Shift to return to a solid pen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 并按颜色键（如 Shift+R）可使用半透明荧光笔绘制。不按 Shift 再次按该颜色键即可恢复为实色画笔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 並按顏色鍵（例如 Shift+R）可使用半透明螢光筆繪圖。不按 Shift 再次按該顏色鍵即可恢復為實色畫筆。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift+R のように Shift とカラーキーを同時に押すと、半透明の蛍光ペンで描画します。Shift を押さずに同じカラーキーをもう一度押すと、不透明のペンに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift+R처럼 Shift와 색상 키를 함께 누르면 반투명 형광펜으로 그립니다. Shift 없이 같은 색상 키를 다시 누르면 불투명 펜으로 돌아갑니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Shift zusammen mit einer Farbtaste wie Shift+R gedrückt, um mit einem halbtransparenten Textmarker zu zeichnen. Drücke die Farbtaste erneut ohne Shift, um zu einem deckenden Stift zurückzukehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez Shift avec une touche de couleur, par exemple Shift+R, pour dessiner avec un surligneur translucide. Appuyez de nouveau sur la touche de couleur sans Shift pour revenir à un crayon opaque."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Shift con una tecla de color, como Shift+R, para dibujar con un resaltador translúcido. Vuelve a pulsar la tecla de color sin Shift para usar un lápiz opaco."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Shift con una tecla de color, como Shift+R, para dibujar con un resaltador translúcido. Vuelve a presionar la tecla de color sin Shift para usar una pluma opaca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure Shift com uma tecla de cor, como Shift+R, para desenhar com um marca-texto translúcido. Pressione a tecla de cor novamente sem Shift para usar uma caneta opaca."
          }
        }
      }
    },
