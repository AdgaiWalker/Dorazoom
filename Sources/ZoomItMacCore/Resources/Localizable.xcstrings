    "settings.general.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom runs in the menu bar. Use the Zoom and Draw settings to choose the keyboard shortcuts that activate it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom 在菜单栏中运行。请在“缩放”和“绘图”设置中选择用于激活它的键盘快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom 會在選單列中執行。請在「縮放」和「繪圖」設定中選擇用來啟用它的鍵盤快速鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom はメニューバーで動作します。「ズーム」と「描画」の設定で、各機能を呼び出すキーボードショートカットを選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom은 메뉴 막대에서 실행됩니다. 확대 및 그리기 설정에서 활성화할 키보드 단축키를 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom läuft in der Menüleiste. Wähle unter „Zoom“ und „Zeichnen“ die Kurzbefehle aus, die DoraZoom aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom fonctionne dans la barre des menus. Utilisez les réglages Zoom et Dessin pour choisir les raccourcis qui l’activent."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom se ejecuta en la barra de menús. Usa los ajustes de Zoom y Dibujo para elegir los atajos que lo activan."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom se ejecuta en la barra de menús. Usa la configuración de Zoom y Dibujo para elegir los atajos que activan DoraZoom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DoraZoom é executado na barra de menus. Use os ajustes de Zoom e Desenho para escolher os atalhos que ativam o DoraZoom."
          }
        }
      }
    },
