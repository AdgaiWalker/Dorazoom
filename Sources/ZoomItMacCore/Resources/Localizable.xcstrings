    "settings.break_timer.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the break timer shortcut to show a full-screen countdown. Use the Arrow keys or mouse wheel to adjust the time, color keys to change the timer color, and Escape or right-click to exit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按休息计时器快捷键显示全屏倒计时。使用方向键或鼠标滚轮调整时间，使用颜色键更改计时器颜色，按 Escape 或右键点击退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按休息計時器快速鍵顯示全螢幕倒數。使用方向鍵或滑鼠滾輪調整時間，使用顏色鍵更改計時器顏色，按 Escape 或按一下滑鼠右鍵結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩タイマーのショートカットを押すと、フルスクリーンのカウントダウンが表示されます。矢印キーまたはマウスホイールで時間を調整し、カラーキーでタイマーの色を変更します。Escape または右クリックで終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식 타이머 단축키를 누르면 전체 화면 카운트다운이 표시됩니다. 방향키나 마우스 휠로 시간을 조절하고, 색상 키로 타이머 색을 바꿉니다. Escape 또는 오른쪽 클릭으로 종료합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke den Kurzbefehl für den Pausentimer, um einen Countdown im Vollbild anzuzeigen. Passe die Zeit mit den Pfeiltasten oder dem Mausrad an, ändere die Timerfarbe mit den Farbtasten und beende mit Escape oder einem Rechtsklick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le raccourci du minuteur de pause pour afficher un compte à rebours en plein écran. Réglez la durée avec les touches fléchées ou la molette, changez la couleur avec les touches de couleur et quittez avec Échap ou un clic droit."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el atajo del temporizador de descanso para mostrar una cuenta atrás a pantalla completa. Ajusta el tiempo con las flechas o la rueda del ratón, cambia el color con las teclas de color y sal con Escape o un clic derecho."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona el atajo del temporizador de descanso para mostrar una cuenta regresiva a pantalla completa. Ajusta el tiempo con las flechas o la rueda del mouse, cambia el color con las teclas de color y sal con Escape o un clic derecho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione o atalho do temporizador de pausa para mostrar uma contagem regressiva em tela cheia. Ajuste o tempo com as setas ou a roda do mouse, mude a cor com as teclas de cor e saia com Escape ou um clique direito."
          }
        }
      }
    },
