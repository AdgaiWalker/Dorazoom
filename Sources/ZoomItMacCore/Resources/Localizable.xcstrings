    "settings.advanced_recording.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard recordings use MOV / H.264 / AAC. MP4, GIF, and more complex editing are available in the advanced workflow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准录制使用 MOV / H.264 / AAC。MP4、GIF 和更复杂的编辑功能可在高级工作流程中使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準錄製使用 MOV / H.264 / AAC。MP4、GIF 和較複雜的編輯功能可在進階工作流程中使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準の収録には MOV / H.264 / AAC を使用します。MP4、GIF、より複雑な編集は高度なワークフローで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준 녹화는 MOV / H.264 / AAC를 사용합니다. MP4, GIF 및 더 복잡한 편집은 고급 작업 흐름에서 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardaufnahmen verwenden MOV / H.264 / AAC. MP4, GIF und komplexere Bearbeitung sind im erweiterten Arbeitsablauf verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements standard utilisent MOV / H.264 / AAC. MP4, GIF et les montages plus complexes sont disponibles dans le flux avancé."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones estándar usan MOV / H.264 / AAC. Los formatos MP4 y GIF, y las opciones de edición más complejas, están disponibles en el flujo avanzado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones estándar usan MOV / H.264 / AAC. Los formatos MP4 y GIF, y las opciones de edición más complejas, están disponibles en el flujo avanzado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações padrão usam MOV / H.264 / AAC. MP4, GIF e edições mais complexas estão disponíveis no fluxo avançado."
          }
        }
      }
    },
