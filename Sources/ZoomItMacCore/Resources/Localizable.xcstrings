    "settings.draw.privacy_tools.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press M for the blur pen, X for a solid redaction, or N to add an automatically numbered marker. These remain only in the current drawing session and are composited into copied or recorded pixels. Undo with Command-Z or Control-Z before sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 M 使用模糊笔，按 X 进行实色遮盖，按 N 添加自动编号标记。这些内容仅保留在当前绘图会话中，并会合成到复制或录制的像素中。分享前可使用 Command-Z 或 Control-Z 撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 M 使用模糊畫筆，按 X 進行實色遮蔽，按 N 加入自動編號標記。這些內容只會保留在目前的繪圖工作階段中，並合成到複製或錄製的像素中。分享前可使用 Command-Z 或 Control-Z 還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "M を押すとぼかしペン、X を押すと不透明な塗りつぶし、N を押すと自動的に番号が付くマーカーになります。これらは現在の描画セッション内でのみ保持され、コピーまたは収録される画面のピクセルに合成されます。共有前に Command-Z または Control-Z で取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "M을 누르면 흐림 펜, X를 누르면 불투명 가리기, N을 누르면 자동 번호 마커를 추가합니다. 이 효과는 현재 그리기 세션에서만 유지되며, 복사되거나 녹화되는 화면 픽셀에 합성됩니다. 공유하기 전에 Command-Z 또는 Control-Z로 실행 취소할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke M für den Weichzeichnungsstift, X für eine deckende Abdeckung oder N für einen automatisch nummerierten Marker. Sie bleiben nur in der aktuellen Zeichensitzung und werden in kopierte oder aufgenommene Pixel eingerechnet. Widerrufe vor dem Teilen mit Command-Z oder Control-Z."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur M pour le crayon de flou, X pour un masquage opaque ou N pour ajouter un repère numéroté automatiquement. Ils restent dans la session de dessin actuelle et sont intégrés aux pixels copiés ou enregistrés. Annulez avec Command-Z ou Control-Z avant de partager."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa M para el lápiz de desenfoque, X para una ocultación opaca o N para añadir un marcador numerado automáticamente. Solo permanecen en la sesión de dibujo actual y se componen en los píxeles copiados o grabados. Deshaz con Command-Z o Control-Z antes de compartir."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona M para la pluma de desenfoque, X para ocultar con un bloque opaco o N para agregar un marcador numerado automáticamente. Solo permanecen en la sesión de dibujo actual y se integran en los píxeles copiados o grabados. Deshaz con Command-Z o Control-Z antes de compartir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione M para a caneta de desfoque, X para uma tarja opaca ou N para adicionar um marcador numerado automaticamente. Eles só permanecem na sessão de desenho atual e são incorporados aos pixels copiados ou gravados. Desfaça com Command-Z ou Control-Z antes de compartilhar."
          }
        }
      }
    },
