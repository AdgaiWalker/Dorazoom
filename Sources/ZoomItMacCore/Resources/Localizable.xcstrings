    "settings.permissions.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Screen Recording, Accessibility, Input Monitoring, microphone, and camera permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查屏幕录制、辅助功能、输入监控、麦克风和摄像头权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查螢幕錄製、輔助使用、輸入監控、麥克風和相機權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録、アクセシビリティ、入力監視、マイク、カメラのアクセス権を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 녹화, 손쉬운 사용, 입력 모니터링, 마이크, 카메라 권한을 검토합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen für Bildschirmaufnahme, Bedienungshilfen, Eingabeüberwachung, Mikrofon und Kamera prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les autorisations d’enregistrement de l’écran, d’accessibilité, de surveillance de l’entrée, du microphone et de la caméra."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los permisos de grabación de pantalla, accesibilidad, monitorización de entrada, micrófono y cámara."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los permisos de grabación de pantalla, accesibilidad, monitoreo de entrada, micrófono y cámara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as permissões de Gravação de Tela, Acessibilidade, Monitoramento de Entrada, microfone e câmera."
          }
        }
      }
    },
