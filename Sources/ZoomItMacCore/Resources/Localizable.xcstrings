    "recording.recovery.message.fragmented": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom found a fragmented MOV that may be recoverable through its last written fragment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom 发现一个分段式 MOV，可能可以从最后写入的片段中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom 發現一個分段式 MOV，可能可以從最後寫入的片段中復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom がフラグメント化された MOV を見つけました。最後に書き込まれたフラグメントまで復元できる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom이 프래그먼트 형식의 MOV를 찾았습니다. 마지막으로 기록된 프래그먼트까지 복구될 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom hat eine fragmentierte MOV-Datei gefunden, die möglicherweise bis zum letzten geschriebenen Fragment wiederhergestellt werden kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom a trouvé un fichier MOV fragmenté dont le contenu peut être récupéré jusqu’au dernier fragment écrit."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom ha encontrado un MOV fragmentado que podría recuperarse hasta el último fragmento escrito."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "DoraZoom encontró un MOV fragmentado que podría recuperarse hasta el último fragmento escrito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DoraZoom encontrou um MOV fragmentado que pode ser recuperado até o último fragmento gravado."
          }
        }
      }
